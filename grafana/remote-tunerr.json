      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Remote Tuner Traffic Flow",
          "description": "View remote tuner throughput. Note tuner bitrate and tunerlan0 should be effectively the same number but from different sources.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "rate(node_network_receive_bytes_total{instance=\"$instance\", device=\"tunerlan0\"}[1m]) * 8",
                        "format": "time_series",
                        "instant": false,
                        "legendFormat": "tunerlan0 (hdhr <> pi)",
                        "range": true
                      }
                    },
                    "refId": "tunerlan0 (hdhr <> pi)",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(hdhomerun_tuner_network_rate_bits{instance=\"$instance\"})",
                        "instant": false,
                        "legendFormat": "Tuner Bitrate (stat from hdhr)",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "rate(node_network_transmit_bytes_total{instance=\"$instance\", device=\"tailscale0\"}[1m]) * 8",
                        "instant": false,
                        "legendFormat": "tailscale0 (pi <> tailscale encrypt)",
                        "range": true
                      }
                    },
                    "refId": "tailscale0 (pi <> tailscale encrypt)",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",

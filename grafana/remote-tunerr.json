                      "spec": {
                        "editorMode": "code",
                        "expr": "rate(node_network_transmit_bytes_total{instance=\"$instance\", device=\"eth0\"}[1m]) * 8",
                        "instant": false,
                        "legendFormat": "eth0 (out from pi)",
                        "range": true
